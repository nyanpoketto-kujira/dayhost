# ---------------------------------------------------------------------------
# DayHost mc-agent configuration (Fusion Phase E)
# Normally generated by the DayHost orchestrator into the sandbox and written
# with mode 600. Never commit a filled-in copy; never put real tokens here.
# ---------------------------------------------------------------------------

# --- Controller link (Phase B server: app/services/agent_ws.py) -------------
# WebSocket the agent dials. The default Phase-B path is /agent-ws.
CONTROLLER_WS=ws://203.0.113.10:8765/agent-ws
# HTTP base of the panel. Also the base for panel-served artifacts (plugin
# jars, and the delta upload endpoint /api/agent/delta).
CONTROLLER_HTTP=http://203.0.113.10:8765
# Shared secret, sent as the X-Agent-Token header (a ?token= query also works).
# Must equal AGENT_WS_TOKEN (or AGENT_TOKEN) on the DayHost side.
AGENT_TOKEN=change-me-shared-agent-token
# 1 = accept self-signed TLS on wss:// and https://. Keep 0 in production.
WS_INSECURE=0

# --- Directories ------------------------------------------------------------
SERVER_DIR=/home/daytona/mc-orchestrator/server
RUNTIME_DIR=/home/daytona/mc-orchestrator/runtime
TMP_DIR=/home/daytona/mc-orchestrator/agent/tmp
AGENT_PID_FILE=/home/daytona/mc-orchestrator/agent/agent.pid
BACKUP_INDEX=/home/daytona/mc-orchestrator/agent/backup-index.json

# --- Behaviour --------------------------------------------------------------
# Start PaperMC on agent boot.
AUTOSTART=1
# 0 = never download JDK/PaperMC; require an already-provisioned runtime.
PROVISION=1
# Kill leftover java processes that point at SERVER_DIR before starting.
KILL_ORPHANS=1

# --- Java -------------------------------------------------------------------
# Minimum major version. Bumped 25 -> 21 in Phase E (PaperMC 1.21.x ceiling).
# The portable JDK lands in RUNTIME_DIR/jdk21/ and is only used if it reports
# at least this major; a system java >= 21 is an accepted fallback.
JAVA_VERSION=21
JAVA_BIN=
# Heap in MB. Keep -Xmx below the host's RAM.
JAVA_ARGS=-Xms2G -Xmx4G -XX:+UseG1GC -XX:+ParallelRefProcEnabled -XX:MaxGCPauseMillis=200
# Seconds to wait for a clean shutdown before SIGTERM/SIGKILL.
STOP_TIMEOUT=45

# --- PaperMC ----------------------------------------------------------------
PAPER_JAR=paper.jar
# "latest" or a concrete version, e.g. 1.21.4
PAPER_VERSION=latest
# Adoptium arch tag for the portable JDK: x64 or aarch64.
JRE_ARCH=x64

# --- Delta backup -----------------------------------------------------------
BACKUP_ENABLED=1
# Seconds between delta syncs (minimum enforced: 60).
BACKUP_INTERVAL=240
# Max uncompressed bytes per upload batch (MB).
BACKUP_BATCH_MB=128
# save-off / save-all flush before scanning the world.
BACKUP_FLUSH=1
# Seconds to wait after boot before the first sync.
BACKUP_START_DELAY=45
# Hard cap for one delta archive (MB); a larger batch fails loudly.
MAX_DELTA_MB=512
# Lines of recent console output replayed after a reconnect.
MC_LOG_LINES=2000

# --- frpc tunnel (optional; a failure never stops PaperMC) ------------------
# 0 disables the tunnel entirely (state "disabled").
FRP_ENABLED=1
# frps host and bind port.
FRP_SERVER_ADDR=
FRP_SERVER_PORT=7000
# frp auth token (frps auth.token).
FRP_TOKEN=
# Agent-side PaperMC port that frpc forwards.
FRP_LOCAL_PORT=25565
# Port players connect to on the frps host.
FRP_REMOTE_PORT=25565
# Release tag fetched from GitHub releases (binary is never vendored).
FRP_VERSION=0.71.1
# SHA-256 of frp_<version>_linux_<arch>.tar.gz. REQUIRED for any download:
# empty -> no download, tunnel state "unconfigured". Wrong -> download rejected.
# Official list (retrieved 2026-10-24):
#   https://github.com/fatedier/frp/releases/download/v0.71.1/frp_sha256_checksums.txt
#   linux_amd64 -> 1d9875210972a5d1a62b2dc4c48df45ab0af05d3ca1b5e494a014428259df803
#   linux_arm64 -> 8edf590b0c396fa42f9c147121a76af83cfc2002b08f5aef0ea1008c43482019
FRP_SHA256=
# amd64 | arm64 | arm. Empty = detected from platform.machine().
FRP_ARCH=
# frpc stdout/stderr log (appended; the process holds its own descriptor).
FRP_LOG=/home/daytona/mc-orchestrator/runtime/frpc.log

# --- Artifacts --------------------------------------------------------------
# Base URL for panel-served plugin jars. Empty -> CONTROLLER_HTTP.
ARTIFACT_BASE_URL=
# Path template used to rewrite an upstream plugin URL to a panel URL, with
# {name} substituted. EMPTY = the panel has no artifact endpoint yet, so the
# upstream URL is used directly (open question, Phase E report).
ARTIFACT_PATH_TEMPLATE=
