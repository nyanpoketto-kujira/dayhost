# ==============================================================================
# DayHost — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#   cp .env.example .env
# ==============================================================================

# --- Core -------------------------------------------------------------------
# "prod" enables secure cookies + stricter behavior. Use "dev" locally.
DAYHOST_ENV=dev
# Host/port uvicorn binds to. Keep bound to localhost and reverse-proxy it.
APP_HOST=127.0.0.1
APP_PORT=8000
# Comma-separated host:port pairs allowed to reach admin endpoints (optional).
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Daytona (the sandbox worker that actually runs Minecraft) ---------------
# Get the API key: app.daytona.io -> Dashboard -> Keys -> Create Key.
DAYTONA_API_KEY=
# Daytona REST base. Usually unchanged.
DAYTONA_API_BASE=https://app.daytona.io/api
# Sandbox UUID: open your sandbox -> the UUID in the URL / details panel.
SANDBOX_ID=
# Per-request timeout (seconds) and light retry policy for Daytona REST calls.
DAYTONA_TIMEOUT=15
DAYTONA_MAX_RETRIES=2
# OPTIONAL path overrides — uncomment ONLY if the real Daytona endpoints differ
# from the defaults below. {sandbox_id} is substituted at request time.
# DAYTONA_PATH_SANDBOX=/sandbox/{sandbox_id}
# DAYTONA_PATH_START=/sandbox/{sandbox_id}/start
# DAYTONA_PATH_STOP=/sandbox/{sandbox_id}/stop
# DAYTONA_PATH_RECOVER=/sandbox/{sandbox_id}/recover

# --- Daytona toolbox: FILE transport (Fase 3) --------------------------------
# NOT the same base URL as DAYTONA_API_BASE above. Lifecycle lives on
# https://app.daytona.io/api; files live on the per-sandbox proxy
# https://proxy.app.daytona.io/toolbox/{sandboxId}. Never mix the two —
# see docs/daytona-file-api.md.
# Leave empty (recommended) to discover the proxy URL once at runtime from
# /sandbox/{id}/toolbox-proxy-url, then cache it. Set it only to pin the base
# explicitly; {sandbox_id} is substituted at request time.
DAYTONA_TOOLBOX_URL=
# The toolbox proxy publishes NO securitySchemes in its spec, so the scheme is
# still an OPEN QUESTION upstream. This is the mitigation switch:
#   bearer -> send "Authorization: Bearer $DAYTONA_API_KEY" (default, best bet)
#   none   -> send no Authorization header at all
# Any other value is reported as a config error, never a crash.
DAYTONA_TOOLBOX_AUTH=bearer

# --- Daytona toolbox: process / exec (Fase 4-A — daytona_driver.py) ----------
# Same toolbox base URL as the file transport above. These paths come from the
# official reference (v0.225). Every one is overridable on purpose: a wrong
# assumption is corrected by editing this file, never by redeploying code.
DAYTONA_TOOLBOX_PATH_EXEC=/process/session/{session_id}/exec
DAYTONA_TOOLBOX_PATH_SESSION=/process/session
DAYTONA_TOOLBOX_PATH_SESSION_GET=/process/session/{session_id}
DAYTONA_TOOLBOX_PATH_COMMAND=/process/session/{session_id}/command/{command_id}
DAYTONA_TOOLBOX_PATH_PROCESS_STATUS=/process/{name}/status
DAYTONA_TOOLBOX_PATH_PROCESS_LOGS=/process/{name}/logs
# Stateless fallback endpoint (no session required).
DAYTONA_PROCESS_EXEC_PATH=/process/exec
# Which one exec_command uses by default:
#   session    -> POST /process/session/{id}/exec (preferred: keeps cwd/env,
#                 returns a cmdId that can be polled for output)
#   stateless  -> POST /process/exec (one shot). Also forced when
#                 DAYTONA_TOOLBOX_PATH_EXEC is emptied.
DAYTONA_TOOLBOX_EXEC_MODE=session
# Session reused across exec calls so we do not create one per command.
DAYTONA_TOOLBOX_SESSION_ID=dayhost
# Start = POST start + poll GET /sandbox/{id}. Bounds the wait (seconds) and
# the gap between polls.
DAYTONA_START_TIMEOUT=90
DAYTONA_POLL_INTERVAL=2

# --- Agent launch inside the sandbox (Fase 4-A) ------------------------------
# Directory holding agent.py inside the sandbox (relative to the sandbox home).
AGENT_REMOTE_DIR=mc-orchestrator/agent
# Launch template. {dir} is substituted with AGENT_REMOTE_DIR. setsid + nohup
# keep the agent alive after the exec call returns; output goes to agent.log.
AGENT_LAUNCH_CMD=cd {dir} && setsid nohup python3 agent.py >> agent.log 2>&1 &

# --- Agent WebSocket server (Fase 4-B — agent_ws.py) -------------------------
# The agent link is a dedicated stdlib RFC-6455 server on its own port, because
# this venv has no websockets/wsproto and FastAPI @app.websocket would 404.
# See docs/fusion-analysis.md §3 (Option A).
# OFF BY DEFAULT, and app/main.py does NOT start it: Phase C wires it in.
AGENT_WS_ENABLED=false
# Bind address. Keep 127.0.0.1 and let Caddy proxy AGENT_WS_PATH, or bind a
# public interface only if the token below is strong.
AGENT_WS_HOST=127.0.0.1
AGENT_WS_PORT=8765
# Path the agent dials, e.g. ws://host:8765/agent-ws
AGENT_WS_PATH=/agent-ws
# Shared secret. The agent sends it as an "X-Agent-Token" header; a "token" query-string parameter is also accepted.
# accepted). AGENT_WS_TOKEN wins; AGENT_TOKEN is the fallback. If BOTH are
# empty the server still starts but REJECTS every connection with 503 and
# logs why — it will never run an unauthenticated agent link.
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
AGENT_WS_TOKEN=
AGENT_TOKEN=
# Heartbeat: send a ping every N seconds; drop a connection whose last frame
# is older than the stale timeout. Keep the timeout well above the interval.
AGENT_WS_PING_INTERVAL=20
AGENT_WS_STALE_TIMEOUT=75
# Max frame/message size in bytes (4 MiB, matches the agent's client cap).
AGENT_WS_MAX_FRAME=4194304

# --- Orchestrator / fusion core (Fase 4-C — orchestrator/) -------------------
# Everything below maps 1:1 to the `orch_*` fields in app/config.py.
# NOT WIRED YET: app/main.py does not import the orchestrator in this phase, so
# ORCH_ENABLED / ORCH_AUTOSTART are false until Phase D flips them. Setting them
# true here does nothing today.
# The orchestrator itself is master-switched by ORCH_ENABLED (Phase D wires it).
ORCH_ENABLED=false
# Root for the ported storage. Keep mirror/snapshots/deltas in separate dirs.
ORCH_DATA_DIR=./data
# Leave empty to derive from ORCH_DATA_DIR (mirror/, snapshots/, deltas/,
# plugins/, orch-tmp/). Set explicitly to place them on another volume.
ORCH_MIRROR_DIR=
ORCH_SNAPSHOTS_DIR=
ORCH_DELTAS_DIR=
ORCH_PLUGINS_DIR=
ORCH_TMP_DIR=
ORCH_SANDBOX_HOME=/home/daytona
# Snapshot loop: enabled, interval in seconds (21600 s = 6 h, 0 disables the
# loop), how many snapshots to keep, and how many raw delta archives to keep.
ORCH_SNAPSHOT_ENABLED=true
ORCH_SNAPSHOT_INTERVAL=21600
ORCH_SNAPSHOT_KEEP=8
ORCH_DELTA_KEEP=20
# Largest single plugin file accepted on upload: 104857600 bytes (100 MiB).
ORCH_MAX_PLUGIN_BYTES=104857600
# Provisioning bounds, seconds: whole sandbox start, then how long to wait for
# the agent's WS hello after launch, polling every ORCH_CONNECT_POLL seconds.
ORCH_PROVISION_TIMEOUT=180
ORCH_CONNECT_TIMEOUT=60
ORCH_CONNECT_POLL=0.2
# Graceful shutdown, seconds: MC stop, then the RCON/backup flush.
ORCH_STOP_MC_TIMEOUT=90
ORCH_BACKUP_FLUSH_TIMEOUT=120
# Boot the sandbox when the orchestrator starts. Off by default: a panel
# restart must not boot a sandbox unattended (and Phase D is not wired yet).
ORCH_AUTOSTART=false
# Watchdog: on agent disconnect/stale, re-run the idempotent bootstrap after
# ORCH_RECOVERY_GRACE seconds (a normal reconnect beats it), never more often
# than ORCH_RECOVERY_COOLDOWN seconds.
ORCH_RECOVERY_ENABLED=true
ORCH_RECOVERY_GRACE=5
ORCH_RECOVERY_COOLDOWN=30

# --- Auth / session ---------------------------------------------------------
ADMIN_USER=admin
# Generate with:  python scripts/hash_password.py 'your-password'
# Format: pbkdf2_sha256$<iterations>$<salt_hex>$<hash_hex>
ADMIN_PASSWORD_HASH=
# REQUIRED. Long random string. Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Session/cookie lifetime in seconds (default 7 days).
SESSION_TTL=604800
# Cookie name (change only if it collides with another app on the domain).
SESSION_COOKIE=dayhost_session

# --- Minecraft server (as seen from THIS VPS) --------------------------------
# Host must be reachable from the VPS: the FRP/SSH tunnel endpoint or the
# sandbox's public address. With tunnel: 127.0.0.1 and your tunnel port.
MC_HOST=127.0.0.1
MC_PORT=25565
# mcstatus query timeout in seconds.
MC_PING_TIMEOUT=4

# --- Tunnel ------------------------------------------------------------------
# frp  -> we only probe the local socket + look for an frpc process.
# ssh  -> local/remote port-forward; same probes apply.
TUNNEL_MODE=frp
# Public address players connect to. Shown on the dashboard.
PUBLIC_HOST=your-vps.example.com
PUBLIC_PORT=25565
# Optional: path to the frpc log, used as a secondary liveness signal.
FRPC_LOG_PATH=/var/log/frpc.log

# --- FRP client (Fase E) -----------------------------------------------------
# Written into the sandbox agent.env; frpc runs next to PaperMC and no-ops
# safely when unconfigured. frp >= 0.52 takes TOML, so the agent writes
# frpc.toml, never frpc.ini.
# Public address of the frps server (the VPS). Empty = tunnel stays unconfigured.
FRP_SERVER_ADDR=
# frps bind port (the one in frps.toml's bindPort).
FRP_SERVER_PORT=7000
# Shared frp auth token. Never commit a real value.
FRP_TOKEN=
# Agent-side PaperMC port.
FRP_LOCAL_PORT=25565
# Public port on the frps host that players connect to.
FRP_REMOTE_PORT=25565
# frp release tag (binary is fetched from GitHub releases, not vendored).
FRP_VERSION=0.71.1
# SHA-256 of frp_<version>_linux_<arch>.tar.gz. EMPTY = the agent refuses to
# download frpc and reports state "unconfigured" (never an unverified binary).
# Official list: https://github.com/fatedier/frp/releases/download/v0.71.1/frp_sha256_checksums.txt
#   linux_amd64 -> 1d9875210972a5d1a62b2dc4c48df45ab0af05d3ca1b5e494a014428259df803
#   linux_arm64 -> 8edf590b0c396fa42f9c147121a76af83cfc2002b08f5aef0ea1008c43482019
FRP_SHA256=

# --- Storage / sync (Fase 2 — execution gated by SYNC_ENABLED) ----------------
DB_PATH=./data/dayhost.db
# Where world backups are staged before stopping the sandbox.
BACKUP_DIR=./data/backups
# Remote (rclone) target for world sync, e.g. "gdrive:dayhost/worlds".
RCLONE_REMOTE=
# EXECUTION KILL-SWITCH (Fase 2). false (default) = plans are built and logged
# but NOTHING is run, so power actions behave exactly like Fase 1.
# true = pre-stop tar/rsync backup and post-start restore are really executed.
SYNC_ENABLED=false
# Per-step timeout in seconds for tar/rsync/rclone.
SYNC_TIMEOUT=180
# World paths used by the plan builders (as seen by the process running tar).
SYNC_WORLD_SRC=/data/world
SYNC_WORLD_DST=/data

# --- Sync transport (Fase 3) -------------------------------------------------
# How world bytes actually travel: "local" or "daytona-files".
#   local         -> Fase 2 behaviour, unchanged. DEFAULT: leave it alone.
#   daytona-files -> pull/push through the toolbox file API (streaming, no
#                    copy of the world kept in RAM). Still gated by
#                    SYNC_ENABLED above.
SYNC_TRANSPORT=local
# Sandbox-side world directory pulled by the daytona-files transport.
SYNC_REMOTE_WORLD=/data/world
# Optional sandbox-side single-file archive. When set, the transport pulls this
# one file instead of walking the world tree. Empty = walk the tree.
SYNC_REMOTE_ARCHIVE=

# --- Logging (Fase 3) --------------------------------------------------------
# Rotating file log. Directory must exist and be writable; if it is not, the
# app logs a warning and keeps working on stderr instead of crashing.
LOG_FILE=./data/dayhost.log
# Rotate when the file reaches this size (bytes). Default 5 MiB.
LOG_MAX_BYTES=5242880
# How many rotated files to keep: .log.1 .. .log.N (default 5).
LOG_BACKUP_COUNT=5
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# plain -> human-readable lines for `journalctl`/`tail`
# json  -> one JSON object per line, for log shippers
LOG_FORMAT=plain

# --- RCON console (Fase 2) ---------------------------------------------------
# Leave RCON_PASSWORD empty to keep the stub (commands accepted, NOT executed;
# HTTP 200 + executed:false). Set it to really run commands over Source RCON.
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=
# Connect/read timeout per RCON operation, seconds.
RCON_TIMEOUT=5
# Destructive commands (stop, op, deop, ban, kick, whitelist off, gamemode, ...)
# are REFUSED unless this is true. Keep false unless you really mean it.
RCON_ALLOW_DESTRUCTIVE=false
# Minimum seconds between two console commands (per logged-in user).
RCON_MIN_INTERVAL=1
# Audit trail (SQLite table `rcon_audit`): every attempt is recorded, including
# commands REFUSED by the safe-list and requests rate-limited with 429.
# Passwords are never stored. Rows older than this many days are purged at
# startup; 0 disables purging (keep everything).
RCON_AUDIT_RETENTION_DAYS=30
