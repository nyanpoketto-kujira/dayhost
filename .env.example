# ==============================================================================
# DayHost — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#   cp .env.example .env
# ==============================================================================

# --- Core -------------------------------------------------------------------
# "prod" enables secure cookies + stricter behavior. Use "dev" locally.
DAYHOST_ENV=dev
# Host/port uvicorn binds to. Keep bound to localhost and reverse-proxy it.
APP_HOST=127.0.0.1
APP_PORT=8000
# Comma-separated host:port pairs allowed to reach admin endpoints (optional).
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Daytona (the sandbox worker that actually runs Minecraft) ---------------
# Get the API key: app.daytona.io -> Dashboard -> Keys -> Create Key.
DAYTONA_API_KEY=
# Daytona REST base. Usually unchanged.
DAYTONA_API_BASE=https://app.daytona.io/api
# Sandbox UUID: open your sandbox -> the UUID in the URL / details panel.
SANDBOX_ID=
# Per-request timeout (seconds) and light retry policy for Daytona REST calls.
DAYTONA_TIMEOUT=15
DAYTONA_MAX_RETRIES=2
# OPTIONAL path overrides — uncomment ONLY if the real Daytona endpoints differ
# from the defaults below. {sandbox_id} is substituted at request time.
# DAYTONA_PATH_SANDBOX=/sandbox/{sandbox_id}
# DAYTONA_PATH_START=/sandbox/{sandbox_id}/start
# DAYTONA_PATH_STOP=/sandbox/{sandbox_id}/stop
# DAYTONA_PATH_RECOVER=/sandbox/{sandbox_id}/recover

# --- Daytona toolbox: FILE transport (Fase 3) --------------------------------
# NOT the same base URL as DAYTONA_API_BASE above. Lifecycle lives on
# https://app.daytona.io/api; files live on the per-sandbox proxy
# https://proxy.app.daytona.io/toolbox/{sandboxId}. Never mix the two —
# see docs/daytona-file-api.md.
# Leave empty (recommended) to discover the proxy URL once at runtime from
# /sandbox/{id}/toolbox-proxy-url, then cache it. Set it only to pin the base
# explicitly; {sandbox_id} is substituted at request time.
DAYTONA_TOOLBOX_URL=
# The toolbox proxy publishes NO securitySchemes in its spec, so the scheme is
# still an OPEN QUESTION upstream. This is the mitigation switch:
#   bearer -> send "Authorization: Bearer $DAYTONA_API_KEY" (default, best bet)
#   none   -> send no Authorization header at all
# Any other value is reported as a config error, never a crash.
DAYTONA_TOOLBOX_AUTH=bearer

# --- Auth / session ---------------------------------------------------------
ADMIN_USER=admin
# Generate with:  python scripts/hash_password.py 'your-password'
# Format: pbkdf2_sha256$<iterations>$<salt_hex>$<hash_hex>
ADMIN_PASSWORD_HASH=
# REQUIRED. Long random string. Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Session/cookie lifetime in seconds (default 7 days).
SESSION_TTL=604800
# Cookie name (change only if it collides with another app on the domain).
SESSION_COOKIE=dayhost_session

# --- Minecraft server (as seen from THIS VPS) --------------------------------
# Host must be reachable from the VPS: the FRP/SSH tunnel endpoint or the
# sandbox's public address. With tunnel: 127.0.0.1 and your tunnel port.
MC_HOST=127.0.0.1
MC_PORT=25565
# mcstatus query timeout in seconds.
MC_PING_TIMEOUT=4

# --- Tunnel ------------------------------------------------------------------
# frp  -> we only probe the local socket + look for an frpc process.
# ssh  -> local/remote port-forward; same probes apply.
TUNNEL_MODE=frp
# Public address players connect to. Shown on the dashboard.
PUBLIC_HOST=your-vps.example.com
PUBLIC_PORT=25565
# Optional: path to the frpc log, used as a secondary liveness signal.
FRPC_LOG_PATH=/var/log/frpc.log

# --- Storage / sync (Fase 2 — execution gated by SYNC_ENABLED) ----------------
DB_PATH=./data/dayhost.db
# Where world backups are staged before stopping the sandbox.
BACKUP_DIR=./data/backups
# Remote (rclone) target for world sync, e.g. "gdrive:dayhost/worlds".
RCLONE_REMOTE=
# EXECUTION KILL-SWITCH (Fase 2). false (default) = plans are built and logged
# but NOTHING is run, so power actions behave exactly like Fase 1.
# true = pre-stop tar/rsync backup and post-start restore are really executed.
SYNC_ENABLED=false
# Per-step timeout in seconds for tar/rsync/rclone.
SYNC_TIMEOUT=180
# World paths used by the plan builders (as seen by the process running tar).
SYNC_WORLD_SRC=/data/world
SYNC_WORLD_DST=/data

# --- Sync transport (Fase 3) -------------------------------------------------
# How world bytes actually travel: "local" or "daytona-files".
#   local         -> Fase 2 behaviour, unchanged. DEFAULT: leave it alone.
#   daytona-files -> pull/push through the toolbox file API (streaming, no
#                    copy of the world kept in RAM). Still gated by
#                    SYNC_ENABLED above.
SYNC_TRANSPORT=local
# Sandbox-side world directory pulled by the daytona-files transport.
SYNC_REMOTE_WORLD=/data/world
# Optional sandbox-side single-file archive. When set, the transport pulls this
# one file instead of walking the world tree. Empty = walk the tree.
SYNC_REMOTE_ARCHIVE=

# --- Logging (Fase 3) --------------------------------------------------------
# Rotating file log. Directory must exist and be writable; if it is not, the
# app logs a warning and keeps working on stderr instead of crashing.
LOG_FILE=./data/dayhost.log
# Rotate when the file reaches this size (bytes). Default 5 MiB.
LOG_MAX_BYTES=5242880
# How many rotated files to keep: .log.1 .. .log.N (default 5).
LOG_BACKUP_COUNT=5
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# plain -> human-readable lines for `journalctl`/`tail`
# json  -> one JSON object per line, for log shippers
LOG_FORMAT=plain

# --- RCON console (Fase 2) ---------------------------------------------------
# Leave RCON_PASSWORD empty to keep the stub (commands accepted, NOT executed;
# HTTP 200 + executed:false). Set it to really run commands over Source RCON.
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=
# Connect/read timeout per RCON operation, seconds.
RCON_TIMEOUT=5
# Destructive commands (stop, op, deop, ban, kick, whitelist off, gamemode, ...)
# are REFUSED unless this is true. Keep false unless you really mean it.
RCON_ALLOW_DESTRUCTIVE=false
# Minimum seconds between two console commands (per logged-in user).
RCON_MIN_INTERVAL=1
# Audit trail (SQLite table `rcon_audit`): every attempt is recorded, including
# commands REFUSED by the safe-list and requests rate-limited with 429.
# Passwords are never stored. Rows older than this many days are purged at
# startup; 0 disables purging (keep everything).
RCON_AUDIT_RETENTION_DAYS=30
